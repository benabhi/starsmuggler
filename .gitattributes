# Line endings (SMUG-82): LF in the repository and in the working copy for everything, so git
# never warns about CRLF conversions; Windows scripts keep CRLF.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries are never converted.
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.otf binary
*.mp3 binary
*.ogg binary
*.wav binary
*.jar binary
*.apk binary
